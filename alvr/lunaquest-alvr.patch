+    let (cx, cy) = ((left + right) / 2.0, (top + bottom) / 2.0);
+    let (hw, hh) = ((right - left) / 2.0, (bottom - top) / 2.0);
+    let radius = PANEL_RADIUS.min(hw).min(hh);
+    for y in top.floor() as i32..=bottom.ceil() as i32 {
+        for x in left.floor() as i32..=right.ceil() as i32 {
+            let qx = (x as f32 + 0.5 - cx).abs() - (hw - radius);
+            let qy = (y as f32 + 0.5 - cy).abs() - (hh - radius);
+            let outside = (qx.max(0.0).powi(2) + qy.max(0.0).powi(2)).sqrt();
+            let dist = outside + qx.max(qy).min(0.0) - radius;
+            let coverage = (0.5 - dist).clamp(0.0, 1.0);
+            if coverage <= 0.0 {
+                continue;
+            }
+            let border = (dist + PANEL_BORDER_WIDTH + 0.5).clamp(0.0, 1.0);
+            let rgb = [
+                lerp(PANEL_FILL[0], PANEL_BORDER[0], border),
+                lerp(PANEL_FILL[1], PANEL_BORDER[1], border),
+                lerp(PANEL_FILL[2], PANEL_BORDER[2], border),
+            ];
+            let alpha = lerp(PANEL_FILL[3], PANEL_BORDER[3], border) / 255.0 * coverage;
+            blend_pixel(buffer, x, y, rgb, alpha);
+        }
+    }
+}
+
+// Petite lune éclairée par la gauche, avec trois cratères
+fn draw_moon_icon(buffer: &mut [u8], (cx, cy): (f32, f32), radius: f32) {
+    let craters = [(-0.35, 0.15, 0.27), (0.28, -0.38, 0.17), (0.08, 0.45, 0.14)];
+    for y in (cy - radius - 2.0) as i32..=(cy + radius + 2.0) as i32 {
+        for x in (cx - radius - 2.0) as i32..=(cx + radius + 2.0) as i32 {
+            let (dx, dy) = (x as f32 + 0.5 - cx, y as f32 + 0.5 - cy);
+            let coverage = (radius + 0.5 - (dx * dx + dy * dy).sqrt()).clamp(0.0, 1.0);
+            if coverage <= 0.0 {
+                continue;
+            }
+            let (lx, ly) = (dx / radius, dy / radius);
+            let z = (1.0 - (lx * lx + ly * ly)).max(0.0).sqrt();
+            let light = (-0.65 * lx - 0.35 * ly + 0.68 * z).clamp(0.0, 1.0);
+            let shade = 0.25 + 0.85 * light;
+            let mut rgb = [
+                lerp(176.0, 252.0, z) * shade,
+                lerp(194.0, 253.0, z) * shade,
+                lerp(232.0, 255.0, z) * shade,
+            ];
+            for (ox, oy, cr) in craters {
+                if ((lx - ox) * (lx - ox) + (ly - oy) * (ly - oy)).sqrt() < cr {
+                    rgb = rgb.map(|c| c * 0.82);
+                }
+            }
+            blend_pixel(buffer, x, y, rgb.map(|c| c.min(255.0)), coverage);
+        }
+    }
+}
+
+fn draw_glyphs(
+    buffer: &mut [u8],
+    font: &FontRef<'_>,
+    scale: f32,
+    glyphs: Vec<SectionGlyph>,
+    rgb: [f32; 3],
+) {
+    let scaled_font = font.as_scaled(scale);
+    for section_glyph in glyphs {
+        if let Some(outlined) = scaled_font.outline_glyph(section_glyph.glyph) {
+            let b = outlined.px_bounds();
+            outlined.draw(|x, y, coverage| {
+                blend_pixel(
+                    buffer,
+                    x as i32 + b.min.x as i32,
+                    y as i32 + b.min.y as i32,
+                    rgb,
+                    coverage,
+                );
+            });
+        }
+    }
+}
