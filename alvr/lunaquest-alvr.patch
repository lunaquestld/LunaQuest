+struct V3 {
+    float x, y, z;
+};
+V3 operator+(V3 a, V3 b) { return { a.x + b.x, a.y + b.y, a.z + b.z }; }
+V3 operator-(V3 a, V3 b) { return { a.x - b.x, a.y - b.y, a.z - b.z }; }
+V3 operator*(V3 a, float s) { return { a.x * s, a.y * s, a.z * s }; }
+float Dot(V3 a, V3 b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+V3 Cross(V3 a, V3 b) { return { a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x }; }
+float Length(V3 a) { return std::sqrt(Dot(a, a)); }
+V3 Normalize(V3 a, V3 fallback) {
+    float l = Length(a);
+    return l > 1e-5f ? a * (1.f / l) : fallback;
+}
+
+FfiQuat Mul(FfiQuat a, FfiQuat b) {
+    return { a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
+             a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
+             a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
+             a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z };
+}
+
+V3 Rotate(FfiQuat q, V3 v) {
+    V3 u = { q.x, q.y, q.z };
+    V3 t = Cross(u, v) * 2.f;
+    return v + t * q.w + Cross(u, t);
+}
+
+// Rotation dont les colonnes sont les axes x, y, z (orthonormés).
+FfiQuat FromBasis(V3 x, V3 y, V3 z) {
+    float trace = x.x + y.y + z.z;
+    FfiQuat q;
+    if (trace > 0) {
+        float s = std::sqrt(trace + 1.f) * 2.f;
+        q = { (y.z - z.y) / s, (z.x - x.z) / s, (x.y - y.x) / s, 0.25f * s };
+    } else if (x.x > y.y && x.x > z.z) {
+        float s = std::sqrt(1.f + x.x - y.y - z.z) * 2.f;
+        q = { 0.25f * s, (y.x + x.y) / s, (z.x + x.z) / s, (y.z - z.y) / s };
+    } else if (y.y > z.z) {
+        float s = std::sqrt(1.f + y.y - x.x - z.z) * 2.f;
+        q = { (y.x + x.y) / s, 0.25f * s, (z.y + y.z) / s, (z.x - x.z) / s };
+    } else {
+        float s = std::sqrt(1.f + z.z - x.x - y.y) * 2.f;
+        q = { (z.x + x.z) / s, (z.y + y.z) / s, 0.25f * s, (x.y - y.x) / s };
+    }
+    return q;
+}
+
+FfiQuat FromEulerDeg(float rx, float ry, float rz) {
+    const float k = 3.14159265f / 360.f;
+    FfiQuat qx = { std::sin(rx * k), 0, 0, std::cos(rx * k) };
+    FfiQuat qy = { 0, std::sin(ry * k), 0, std::cos(ry * k) };
+    FfiQuat qz = { 0, 0, std::sin(rz * k), std::cos(rz * k) };
+    return Mul(Mul(qy, qx), qz);
+}
+
+// Direction « devant » à plat (SteamVR : -Z devant, +Y en haut).
+V3 Forward(FfiQuat q) {
+    V3 f = Rotate(q, { 0, 0, -1 });
+    f.y = 0;
+    return Normalize(f, { 0, 0, -1 });
+}
