+#pragma once
+
+// LunaQuest : suivi du corps combiné.
+// - trackers virtuels au choix (torse, hanches, coudes, genoux, pieds) ;
+// - décalages position / rotation par tracker ;
+// - genoux calculés à partir des vrais trackers (hanches + pieds), pour que les jambes plient
+//   en accord avec les vrais pieds au lieu de suivre les jambes estimées par le casque.
+// Réglages lus dans %APPDATA%\LunaQuest\body.json (écrit par LunaQuest). Sans ce fichier,
+// ALVR garde son comportement d'origine.
+
+#include "bindings.h"
+#include <cstdint>
+#include <map>
+
+namespace LunaBody {
+// Charge (ou recharge) le fichier de réglages. Renvoie false s'il n'existe pas.
+bool Load();
+bool IsActive();
+// Le tracker virtuel doit-il être créé ? alvrDefault : choix d'ALVR quand LunaQuest n'a rien réglé.
+bool JointEnabled(uint64_t id, bool alvrDefault);
+// Mode FBE Mix : torse, coudes et genoux estimés à partir du casque, des manettes et des vrais trackers.
+bool MixMode();
+// À appeler depuis RunFrame après RunFrame() : calcule les trackers virtuels du mode mix.
+void SolveMix(std::map<uint64_t, FfiDeviceMotion>& out);
+// À appeler depuis la boucle de SteamVR (RunFrame) : relève les vrais trackers et leurs positions.
+void RunFrame();
+// Corrige les mouvements du corps (décalages, genoux calculés) avant leur envoi aux trackers.
+void Process(std::map<uint64_t, FfiDeviceMotion>& motions, const FfiDeviceMotion& head);
+}
