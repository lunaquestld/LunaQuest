+std::filesystem::path ConfigPath() {
+    const char* appdata = std::getenv("APPDATA");
+    if (!appdata) return {};
+    return std::filesystem::path(appdata) / "LunaQuest" / "body.json";
+}
+
+const std::map<std::string, uint64_t*> kJointNames = {
+    { "chest", &BODY_CHEST_ID },           { "waist", &BODY_HIPS_ID },
+    { "left_elbow", &BODY_LEFT_ELBOW_ID }, { "right_elbow", &BODY_RIGHT_ELBOW_ID },
+    { "left_knee", &BODY_LEFT_KNEE_ID },   { "right_knee", &BODY_RIGHT_KNEE_ID },
+    { "left_foot", &BODY_LEFT_FOOT_ID },   { "right_foot", &BODY_RIGHT_FOOT_ID },
+};
+
+bool LoadLocked() {
+    auto path = ConfigPath();
+    std::error_code ec;
+    if (path.empty() || !std::filesystem::exists(path, ec)) {
+        g_config = Config {};
+        return false;
+    }
+    auto stamp = std::filesystem::last_write_time(path, ec);
+    if (g_config.loaded && stamp == g_config.stamp) return true;
+
+    std::ifstream file(path);
+    std::stringstream text;
+    text << file.rdbuf();
+    picojson::value root;
+    std::string error = picojson::parse(root, text.str());
+    if (!error.empty() || !root.is<picojson::object>()) {
+        Warn("LunaQuest body.json illisible : %s", error.c_str());
+        return g_config.loaded;
+    }
+
+    Config c;
+    c.loaded = true;
+    c.stamp = stamp;
+    auto& obj = root.get<picojson::object>();
+    if (obj.count("knees_from_real_trackers") && obj.at("knees_from_real_trackers").is<bool>())
+        c.kneesFromReal = obj.at("knees_from_real_trackers").get<bool>();
+    if (obj.count("mode") && obj.at("mode").is<std::string>()) c.mode = obj.at("mode").get<std::string>();
+    if (obj.count("user_height_cm") && obj.at("user_height_cm").is<double>()) c.userHeight = (float)obj.at("user_height_cm").get<double>() / 100.f;
+    if (obj.count("calibration_request") && obj.at("calibration_request").is<double>()) c.calibrationRequest = (int)obj.at("calibration_request").get<double>();
+    if (obj.count("joints") && obj.at("joints").is<picojson::object>()) {
+        for (auto& kv : obj.at("joints").get<picojson::object>()) {
+            auto it = kJointNames.find(kv.first);
+            if (it != kJointNames.end() && kv.second.is<bool>()) c.joints[*it->second] = kv.second.get<bool>();
+        }
+    }
+    if (obj.count("offsets") && obj.at("offsets").is<picojson::object>()) {
+        for (auto& kv : obj.at("offsets").get<picojson::object>()) {
+            auto it = kJointNames.find(kv.first);
+            if (it == kJointNames.end() || !kv.second.is<picojson::array>()) continue;
+            auto& arr = kv.second.get<picojson::array>();
+            std::array<float, 6> o {};
+            for (size_t i = 0; i < 6 && i < arr.size(); i++)
+                if (arr[i].is<double>()) o[i] = (float)arr[i].get<double>();
+            c.offsets[*it->second] = o;
+        }
+    }
+    g_config = c;
+    Info("LunaQuest : réglages du corps chargés (%d trackers).", (int)c.joints.size());
+    return true;
+}
