+        for (var i = 0; i < 5; i++) {
+            if distance(local, craters[i].xy) < craters[i].z {
+                moon *= 0.84;
+            }
+        }
+        color = mix(color, moon, smoothstep(1.0, 0.95, length(local)));
+    }
+    return color;
+}
