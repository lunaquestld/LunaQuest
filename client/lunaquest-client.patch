+
+// Étoiles fixes dans le ciel : une étoile dans une petite partie des cellules d'une grille 3D
+fn stars(dir: vec3f) -> vec3f {
+    let p = dir * 140.0;
+    let cell = floor(p);
+    if hash3(cell) < 0.982 {
+        return vec3f(0.0);
+    }
+    let star_pos = cell + vec3f(hash3(cell + 1.3), hash3(cell + 2.7), hash3(cell + 4.1));
+    let size = 0.12 + 0.22 * hash3(cell + 7.7);
+    let intensity = smoothstep(size, 0.0, length(p - star_pos)) * (0.45 + 0.55 * hash3(cell + 9.1));
+    let tint = mix(vec3f(1.0, 1.0, 1.0), vec3f(0.62, 0.75, 1.0), hash3(cell + 5.5));
+    return tint * intensity;
+}
+
+fn sky(dir: vec3f) -> vec3f {
+    let height = clamp(dir.y, 0.0, 1.0);
+    var color = mix(SKY_HORIZON, SKY_ZENITH, sqrt(height));
+    color += stars(dir) * smoothstep(-0.02, 0.10, dir.y);
+
+    // Lune, éclairée par la gauche, avec quelques cratères
+    let moon_dir = normalize(vec3f(-0.50, 0.45, -0.75));
+    let moon_radius = 0.06;
+    let angle = acos(clamp(dot(dir, moon_dir), -1.0, 1.0));
+    color += MOON_GLOW * 0.22 * exp(-angle * 11.0);
+    if angle < moon_radius * 1.05 {
+        let right = normalize(cross(moon_dir, vec3f(0.0, 1.0, 0.0)));
+        let up = cross(right, moon_dir);
+        let local = vec2f(dot(dir - moon_dir, right), dot(dir - moon_dir, up)) / moon_radius;
+        let z = sqrt(max(0.0, 1.0 - dot(local, local)));
+        let light = normalize(vec3f(-0.65, 0.35, 0.68));
+        let diffuse = clamp(dot(vec3f(local, z), light), 0.0, 1.0);
+        var moon = mix(vec3f(0.70, 0.76, 0.88), vec3f(1.0, 1.0, 1.0), z) * (0.18 + 0.90 * diffuse);
+        var craters = array<vec3f, 5>(
+            vec3f(-0.35, 0.10, 0.26),
+            vec3f(0.28, 0.40, 0.17),
+            vec3f(0.10, -0.45, 0.14),
+            vec3f(-0.05, -0.12, 0.09),
+            vec3f(0.48, -0.05, 0.11),
