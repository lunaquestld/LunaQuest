+// Compose une couleur par-dessus le pixel existant (opérateur « over »)
+fn blend_pixel(buffer: &mut [u8], x: i32, y: i32, rgb: [f32; 3], alpha: f32) {
+    let side = HUD_TEXTURE_SIDE as i32;
+    if alpha <= 0.0 || x < 0 || y < 0 || x >= side || y >= side {
+        return;
+    }
+    let i = (y as usize * HUD_TEXTURE_SIDE + x as usize) * 4;
+    let a = alpha.min(1.0);
+    let dst_a = buffer[i + 3] as f32 / 255.0;
+    let out_a = a + dst_a * (1.0 - a);
+    if out_a <= 0.0 {
+        return;
+    }
+    for c in 0..3 {
+        let dst = buffer[i + c] as f32;
+        buffer[i + c] = ((rgb[c] * a + dst * dst_a * (1.0 - a)) / out_a)
+            .round()
+            .clamp(0.0, 255.0) as u8;
+    }
+    buffer[i + 3] = (out_a * 255.0).round() as u8;
+}
